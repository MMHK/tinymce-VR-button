{
  "name": "tinymce-vr-button",
  "version": "1.0.0",
  "description": "TinyMCE 4 VR Button Plugin for 720yun.com with rspack build system",
  "main": "dist/plugin.js",
  "scripts": {
    "dev": "rspack serve --mode development",
    "build": "rspack build --mode production",
    "build:dev": "rspack build --mode development",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "tinymce",
    "plugin",
    "vr",
    "720yun",
    "360",
    "panorama"
  ],
  "author": "MMHK",
  "license": "MIT",
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "@rspack/cli": "^1.2.0",
    "@rspack/core": "^1.2.0",
    "@rspack/dev-server": "^1.2.0",
    "css-loader": "^7.1.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "style-loader": "^4.0.0",
    "tinymce": "4.0.26"
  }
}
